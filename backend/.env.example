# Application Configuration
APP_NAME="Monkspaces Shared Data Platform"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Security & CORS
# In production, specify explicit client origins (e.g., https://app.monkspaces.com)
CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200"]

# Database (PostgreSQL) - Required in persistence milestone
DATABASE_URL="postgresql+asyncpg://monkspaces_user:CHANGE_ME@localhost:5432/monkspaces_db"

# Tenant & Security Defaults
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200

# Application Configuration
APP_NAME="Monkspaces Shared Data Platform"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Security & CORS
# In production, specify explicit client origins (e.g., https://app.monkspaces.com)
CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200"]

# Database (PostgreSQL) - Required in persistence milestone
# Any postgres:// or postgresql:// URL works (Neon URLs as given); the app uses psycopg 3.
DATABASE_URL="postgresql://monkspaces_user:CHANGE_ME@localhost:5432/monkspaces_db"

# Background jobs: set to use Celery workers; leave empty to run jobs inside the API process.
REDIS_URL=""

# Seed command password (python -m app.seed demo). Leave unset to generate one.
# SEED_PASSWORD=""

# Tenant & Security Defaults
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200

# Auth: JWT signing key (required in production).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY="CHANGE_ME"

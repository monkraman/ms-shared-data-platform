# Root Environment Configuration Template for Monkspaces Shared Data Platform
# Copy to backend/.env for local backend development

# Application
APP_NAME="Monkspaces Shared Data Platform"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200"]

# PostgreSQL Database (Local Development)
DATABASE_URL="postgresql+asyncpg://monkspaces_user:CHANGE_ME@localhost:5432/monkspaces_db"

# Pagination Defaults
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200
